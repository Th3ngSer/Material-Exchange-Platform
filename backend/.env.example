PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/material_xchange
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=1d

# Comma-separated list of allowed origins. Wildcards (*) are supported.
# Example: ALLOWED_ORIGINS=https://material-exchange-platform.pages.dev,https://*.material-exchange-platform.pages.dev
ALLOWED_ORIGINS=https://material-exchange-platform.pages.dev

# Optional: single frontend origin override (useful for production)
FRONTEND_ORIGIN=https://material-exchange-platform.pages.dev