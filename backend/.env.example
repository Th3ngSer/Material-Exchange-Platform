PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/material_xchange
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=1d

# Comma-separated list of allowed origins. Wildcards (*) are supported.
# Example: ALLOWED_ORIGINS=https://material-exchange-platform.pages.dev,https://*.material-exchange-platform.pages.dev
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000